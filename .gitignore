# Python/runtime artifacts
.venv/
__pycache__/
*.pyc

# Generated build workspace, backups, and archives.
# Active knowledge artifacts under data/ remain trackable by policy.
data/.build_tmp/
data/backups/
data/archive/

# Generated local knowledge indexes
data/*.db

# Local semantic vector index: machine- and model-specific, rebuild with
# `python main.py --build-embeddings` instead of committing it.
data/semantic_index/

# Synthetische voorbeelddata: deterministisch en in 1 seconde te herbouwen met
# `python scripts/generate_mock_data.py`. Het profiel (klein) staat wel in git,
# want de app leest dat.
data/mock/*.csv

# Ruwe webcache: puur snelheid, per machine, opnieuw op te halen.
data/web_cache/raw/
